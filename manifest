appname               = com.dashboard.nasdash
version               = 2.0.3
display_name          = NAS硬件监控
desc                  = <p><b>nasdash</b> 是飞牛OS 上的 NAS 硬件监控面板，把原本要 SSH 敲命令才能查看的 CPU、内存、温度、风扇、硬盘 SMART、阵列卡、存储卷等状态聚合到一个网页里。</p><p><b>主要功能</b>：硬件概览 · 阵列卡 · 硬盘 SMART · 系统资源监控 · 风扇调速 · 存储卷 · Docker 监控 · 温度与硬盘健康告警 · 一键健康报告</p><p>安装时自动安装 smartmontools、lm-sensors、mdadm 等依赖；MegaRAID/HBA 阵列卡所需的 <b>storcli 已随包内置</b>，无需手动下载。</p><!--APP_CHANGELOG_START--><p><b>最近更新</b></p><ul><li><b>2.0.2</b> 温度监控独立页去重优化（移除与系统资源页重复的 CPU/内存指标，新增最高/平均温度、测点计数与状态徽章）；三档明暗主题跟随飞牛；SVG 线框图标对齐飞牛原生风格；真实 CPU 使用率采集</li><li><b>2.0.1</b> 论坛反馈修复：温度传感器精简为仅显示主板/CPU/南桥三项；风扇控制去除调速方式与无反馈线异常显示；阵列卡独立页合并进硬件检测去重</li><li><b>2.0.0</b> 界面全面换新装（蓝紫渐变透明图标、飞牛原生配色对齐），新增硬盘 SMART 自检（A 档）、坏块慢扫（B 档）、风扇控制接管总开关</li></ul><!--APP_CHANGELOG_END-->
platform              = x86
source                = thirdparty
maintainer            = han951meng
distributor           = han951meng
maintainer_url         = https://github.com/han951meng
distributor_url        = https://github.com/han951meng
os_min_version        = 0.9.0
desktop_uidir         = ui
desktop_applaunchname = com.dashboard.nasdash.main
ctl_stop              = true
; 统一网关（gatewaySocket/gatewayPrefix）对第三方 app 不可靠：飞牛会周期性清空第三方
; entry.gateway_socket -> 网关转发 404（实测反复清空）。改用 fnpackup 同款【cgi 反代】：
; ui/config 的 url=/cgi/ThirdParty/com.dashboard.nasdash/index.cgi/，ui/index.cgi(bash)
; 把请求 curl 转发到 127.0.0.1:9800（Flask 监听）。飞牛不需要注册 gateway 入口 -> 稳定。
; service_port=9800 + checkport=true 让飞牛探测就绪。
service_port          = 9800
checkport             = true
changelog             = 2.0.3: 修复应用中心打开 404(彻底改走 cgi 反代模式：ui/config 改用 /cgi/ThirdParty/com.dashboard.nasdash/index.cgi/ + 新增 ui/index.cgi 转发到 127.0.0.1:9800，对齐 fnpackup 等稳定第三方应用，不再依赖会被飞牛周期性清空的统一网关入口)；删除网关自愈看门狗(cgi 模式不需要)、一键健康报告「复制诊断信息」改弹窗查看运行日志(错误/警告置顶着色)、CPU 温度标注最准封装温度 2.0.2: 温度监控独立页去重优化（移除与系统资源页重复的 CPU/内存指标，新增最高/平均温度、测点计数与状态徽章）；三档明暗主题跟随飞牛；SVG 线框图标对齐飞牛原生风格；真实 CPU 使用率采集 2.0.1: 论坛反馈修复：温度传感器精简为仅显示主板/CPU/南桥三项；风扇控制去除调速方式与无反馈线异常显示；阵列卡独立页合并进硬件检测去重 2.0.0: 界面全面换新装（蓝紫渐变透明图标、飞牛原生配色对齐），新增硬盘 SMART 自检（A 档）、坏块慢扫（B 档）、风扇控制接管总开关
