appname               = com.dashboard.nasdash
version               = 2.0.8
display_name          = NAS硬件监控
desc                  = <p><b>nasdash</b> 是飞牛OS 上的 NAS 硬件监控面板，把原本要 SSH 敲命令才能查看的 CPU、内存、温度、风扇、硬盘 SMART、阵列卡、存储卷等状态聚合到一个网页里。</p><p><b>主要功能</b>：硬件概览 · 阵列卡 · 硬盘 SMART · 系统资源监控 · 风扇调速 · 存储卷 · Docker 监控 · 温度与硬盘健康告警 · 一键健康报告</p><p>安装时自动安装 smartmontools、lm-sensors、mdadm 等依赖；MegaRAID/HBA 阵列卡所需的 <b>storcli 已随包内置</b>，无需手动下载。</p><!--APP_CHANGELOG_START--><p><b>最近更新</b></p><ul><li><b>2.0.8</b> 系统资源页卡片改造：CPU / 内存卡片精简（去掉副标题、对齐更紧凑）；网络卡片由原来的每网口切换改为合并全部网口成一张图（↑上传 / ↓下载 图例 + 单张合并折线）；新增「显卡(GPU)卡」展示实时温度 + 显存占用两条合并折线（更详细的利用率 / Video / Render 指标是飞牛系统自带的「资源管理器」功能，nasdash 未复刻这部分）；Docker 监控修复（CPU 占用率改为整机占比，G5400 4 线程曾虚高约 4 倍；数据缓存 60s→5s、标签页独立 8s 定时器）；安装向导文案修正（cgi 反代访问方式、路径、功能列表对齐现行版本）；阵列卡增强全套 7 项：物理盘定位/闪灯、一致性检查与进度、告警分级与按级别选通知渠道、定时巡检调度、SMART 错误自动 CopyBack 换盘、热备盘分配（全局/专用）、缓存策略展示（写回/直写）。本机为 JBOD 直通（无硬件 RAID 逻辑盘），依赖硬件 RAID 的功能已完成代码与降级验证，真实流程待有 VD 环境补测。</li><li><b>2.0.7</b> 系统资源页网络卡片重新设计：支持多网口切换并显示网卡型号与驱动、上下行速率显示更紧凑准确；休眠硬盘不再误报红色健康警告（真实故障仍标红）；硬盘自检新增历史记录并修复预计剩余时间精度；系统资源页图表精简为极简风格</li><li><b>2.0.6</b> 修复深色模式下下拉框文字空白（风扇控制页「温度源」等下拉框在深色模式下文字与背景同色、部分浏览器内核完全不显示，2.0 以来一直存在）；深色模式下所有下拉框/输入框文字统一显式设为白色，不再受浏览器内核差异影响；下拉选项列表同步适配深色主题（深底白字）</li></ul><!--APP_CHANGELOG_END-->
platform              = x86
source                = thirdparty
maintainer            = han951meng
distributor           = han951meng
maintainer_url         = https://github.com/han951meng
distributor_url        = https://github.com/han951meng
os_min_version        = 0.9.0
desktop_uidir         = ui
desktop_applaunchname = com.dashboard.nasdash.main
ctl_stop              = true
; 统一网关（gatewaySocket/gatewayPrefix）对第三方 app 不可靠：飞牛会周期性清空第三方
; entry.gateway_socket -> 网关转发 404（实测反复清空）。改用 fnpackup 同款【cgi 反代】：
; ui/config 的 url=/cgi/ThirdParty/com.dashboard.nasdash/index.cgi/，ui/index.cgi(bash)
; 把请求 curl 转发到 127.0.0.1:9800（Flask 监听）。飞牛不需要注册 gateway 入口 -> 稳定。
; service_port=9800 + checkport=true 让飞牛探测就绪。
service_port          = 9800
checkport             = true
