appname               = com.dashboard.nasdash
version               = 2.3.3
display_name          = NAS硬件监控
desc                  = <p><b>nasdash</b> 是飞牛OS 上的 NAS 硬件监控面板，把原本要 SSH 敲命令才能查看的 CPU、内存、温度、风扇、硬盘 SMART、阵列卡、存储卷等状态聚合到一个网页里。</p><p><b>主要功能</b>：硬件概览 · 阵列卡 · 硬盘 SMART · 系统资源监控 · 风扇调速 · 存储卷 · Docker 监控 · 端口占用 · 温度与硬盘健康告警 · 一键健康报告</p><p>安装时自动安装 smartmontools、lm-sensors、mdadm 等依赖；MegaRAID/HBA 阵列卡所需的 <b>storcli 已随包内置</b>，无需手动下载。</p><!--APP_CHANGELOG_START--><p><b>最近更新</b></p><ul><li><b>2.3.3</b> 【风扇历史】趋势图「风扇」指标改为每台扇独立彩色曲线，曲线上按接管状态打点（绿=软件接管、红=交还主板）且仅在起始与状态变化拐点打点；历史图直接读取风扇控制页自定义名，改名后该扇所有历史记录同步改名（数据不丢、零残留），风扇控制里隐藏的空口扇历史图一并隐藏。【风扇控制】修复 hwmon 重启漂移导致标签错位、改名偶尔像没保存的问题，改名保存交互优化（编辑输入框后自动出现保存按钮、立即生效无需刷新）；修复「硬盘温度」源预览页偶发把硬盘温度显示为空的问题，现已正确列出每块盘真实温度。</li><li><b>2.3.2</b> 修复风扇控制按「硬盘温度」源时读不到 SAS 企业盘温度的问题（SAS 盘温度此前读成空值、风扇档位无变化），现正确读取；风扇低温行为优化：硬盘/系统温度低于设定开转温度时，风扇不再交还主板自动策略（部分主板会拉到 100% 全速噪音大），改为按你设的最低转速待机，温度到了再升速；修复组了 RAID5 等逻辑盘的阵列卡上「逻辑盘/一致性检查/热备盘」等功能区块被误判无逻辑盘而整块隐藏的问题；温度监控页新增「阵列卡硬盘」温度组：RAID 阵列成员盘系统里看不到独立盘符，现在由阵列卡上报温度并在温度页展示（NVMe/SSD/机械盘照旧）；SAS 硬盘在温度卡片上带「SAS」身份角标，和 SATA 盘一眼区分。</li><li><b>2.3.1</b> 修复阵列卡温度显示偏差：之前只显示 ROC 芯片温度（偏高），与飞牛界面 / storcli 对照工具看到的「控制器温度」差好几度、刷新永远对不上。现同时展示两个独立传感器温度（芯片 ROC + 控制器），并标注两者差异原因；温度采集缓存由 60s 收紧到 15s，缩短采集失败后的恢复时间。同时修复「物理硬盘信息页看不到阵列卡背后的物理盘」：组 RAID 阵列后物理盘被卡攥住、系统无 /dev 节点，之前前端用空盘符当身份证导致多块盘只渲染成一张；现给每块盘分配阵列卡唯一身份证并按槽位命名，物理盘全部可见、点开可看通道与健康（无 /dev 节点故不支持自检）。</li></ul><!--APP_CHANGELOG_END-->
platform              = x86
source                = thirdparty
maintainer            = han951meng
distributor           = han951meng
maintainer_url         = https://github.com/han951meng
distributor_url        = https://github.com/han951meng
os_min_version        = 0.9.0
desktop_uidir         = ui
desktop_applaunchname = com.dashboard.nasdash.main
ctl_stop              = true
; 统一网关（gatewaySocket/gatewayPrefix）对第三方 app 不可靠：飞牛会周期性清空第三方
; entry.gateway_socket -> 网关转发 404（实测反复清空）。改用 fnpackup 同款【cgi 反代】：
; ui/config 的 url=/cgi/ThirdParty/com.dashboard.nasdash/index.cgi/，ui/index.cgi(bash)
; 把请求 curl 转发到 127.0.0.1:9800（Flask 监听）。飞牛不需要注册 gateway 入口 -> 稳定。
; service_port=9800 + checkport=true 让飞牛探测就绪。
service_port          = 9800
checkport             = true
