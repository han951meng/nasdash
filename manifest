ctl_stop              = true
; 统一网关（gatewaySocket/gatewayPrefix）对第三方 app 不可靠：飞牛会周期性清空第三方
; entry.gateway_socket -> 网关转发 404（实测反复清空）。改用 fnpackup 同款【cgi 反代】：
; ui/config 的 url=/cgi/ThirdParty/com.dashboard.nasdash/index.cgi/，ui/index.cgi(bash)
; 把请求 curl 转发到 127.0.0.1:9800（Flask 监听）。飞牛不需要注册 gateway 入口 -> 稳定。
; service_port=9800 + checkport=true 让飞牛探测就绪。
service_port          = 9800
checkport             = true
changelog             = 2.0.5: 新增 C 档·只读表面扫描（badblocks -sv，只读不写数据不伤盘，所有盘可用含在用盘/阵列成员）；扫描面板扇区网格可视化（灰=未扫/绿=正常/红=坏块/黄=当前位，仿硬盘哨兵）+ 面板可最小化收起、后台继续扫；修复坏块扫描进度卡 0%（badblocks 用退格符刷新进度，改取最新值） 2.0.4: CPU 使用率修准（修复偶发 0% 与瞬时 100%/50% 尖刺，改为后台 1 秒窗口采样）；系统负载显示两位小数；阵列卡 ROC 温度并入温度监控页与顶部统计；网络卡片独立接口 + 前端 5 秒实时刷新、顶部网络格子同步实时刷新；温度监控页精简、系统资源页任务管理器风格重构；修复网络速率不刷新与虚拟网卡重复合计问题 2.0.3: 修复应用中心打开 404(彻底改走 cgi 反代模式：ui/config 改用 /cgi/ThirdParty/com.dashboard.nasdash/index.cgi/ + 新增 ui/index.cgi 转发到 127.0.0.1:9800，对齐 fnpackup 等稳定第三方应用，不再依赖会被飞牛周期性清空的统一网关入口)；删除网关自愈看门狗(cgi 模式不需要)、一键健康报告「复制诊断信息」改弹窗查看运行日志(错误/警告置顶着色)、CPU 温度标注最准封装温度 2.0.2: 温度监控独立页去重优化（移除与系统资源页重复的 CPU/内存指标，新增最高/平均温度、测点计数与状态徽章）；三档明暗主题跟随飞牛；SVG 线框图标对齐飞牛原生风格；真实 CPU 使用率采集 2.0.1: 论坛反馈修复：温度传感器精简为仅显示主板/CPU/南桥三项；风扇控制去除调速方式与无反馈线异常显示；阵列卡独立页合并进硬件检测去重 2.0.0: 界面全面换新装（蓝紫渐变透明图标、飞牛原生配色对齐），新增硬盘 SMART 自检（A 档）、坏块慢扫（B 档）、风扇控制接管总开关
