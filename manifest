appname               = com.dashboard.nasdash
version               = 2.3.0
display_name          = NAS硬件监控
desc                  = <p><b>nasdash</b> 是飞牛OS 上的 NAS 硬件监控面板，把原本要 SSH 敲命令才能查看的 CPU、内存、温度、风扇、硬盘 SMART、阵列卡、存储卷等状态聚合到一个网页里。</p><p><b>主要功能</b>：硬件概览 · 阵列卡 · 硬盘 SMART · 系统资源监控 · 风扇调速 · 存储卷 · Docker 监控 · 端口占用 · 温度与硬盘健康告警 · 一键健康报告</p><p>安装时自动安装 smartmontools、lm-sensors、mdadm 等依赖；MegaRAID/HBA 阵列卡所需的 <b>storcli 已随包内置</b>，无需手动下载。</p><!--APP_CHANGELOG_START--><p><b>最近更新</b></p><ul><li><b>2.3.0</b> 新增端口占用页（列出全部监听端口，自动识别是哪个应用 / 容器 / 系统服务在占用，可一键释放）、网卡唤醒开关、硬盘健康分级与缺陷增长趋势、硬盘自定义命名、存储卷映射树、温度预警红线、内存详细信息弹窗（点内存卡查看颗粒厂商/生产日期/序列号/Rank/位宽等），健康报告整份重做并新增脱敏导出；新增网卡未跑满提示（支持 2.5G 但当前协商速率更低时给出瓶颈提示）；修复双磁臂硬盘被当成两块盘、健康报告把软阵列当阵列卡、温度表混入 0℃ 假读数、CPU 使用率恒空等问题。</li><li><b>2.2.0</b> 界面引擎整体换新（11 个页面底层重写、界面样式与旧版一致，页签切换零刷新、切回秒开）；新增错误记录（报错长期保留最多 100 条、可复制可清除）、云盘挂载识别「云盘」标签、运行日志表格化与 10 秒自动刷新；修复旧版风扇曲线模式「保存为曲线」从未生效、运行日志错误条目不着色、CPU 频率只看单核随负载乱跳（改全核平均+每秒刷新）、NVMe 整盘漏计磁盘 I/O、存储卷低使用率百分比被裁切、内存条厂商识别不全（新增 11 家）等问题。</li><li><b>2.1.0</b> 系统资源页新增 GPU 占用与多显卡切换，修复核显占用率、实时刷新、温度墙文字布局问题</li></ul><!--APP_CHANGELOG_END-->
platform              = x86
source                = thirdparty
maintainer            = han951meng
distributor           = han951meng
maintainer_url         = https://github.com/han951meng
distributor_url        = https://github.com/han951meng
os_min_version        = 0.9.0
desktop_uidir         = ui
desktop_applaunchname = com.dashboard.nasdash.main
ctl_stop              = true
; 统一网关（gatewaySocket/gatewayPrefix）对第三方 app 不可靠：飞牛会周期性清空第三方
; entry.gateway_socket -> 网关转发 404（实测反复清空）。改用 fnpackup 同款【cgi 反代】：
; ui/config 的 url=/cgi/ThirdParty/com.dashboard.nasdash/index.cgi/，ui/index.cgi(bash)
; 把请求 curl 转发到 127.0.0.1:9800（Flask 监听）。飞牛不需要注册 gateway 入口 -> 稳定。
; service_port=9800 + checkport=true 让飞牛探测就绪。
service_port          = 9800
checkport             = true
