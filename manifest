appname               = com.dashboard.nasdash
version               = 2.0.7
display_name          = NAS硬件监控
desc                  = <p><b>nasdash</b> 是飞牛OS 上的 NAS 硬件监控面板，把原本要 SSH 敲命令才能查看的 CPU、内存、温度、风扇、硬盘 SMART、阵列卡、存储卷等状态聚合到一个网页里。</p><p><b>主要功能</b>：硬件概览 · 阵列卡 · 硬盘 SMART · 系统资源监控 · 风扇调速 · 存储卷 · Docker 监控 · 温度与硬盘健康告警 · 一键健康报告</p><p>安装时自动安装 smartmontools、lm-sensors、mdadm 等依赖；MegaRAID/HBA 阵列卡所需的 <b>storcli 已随包内置</b>，无需手动下载。</p><!--APP_CHANGELOG_START--><p><b>最近更新</b></p><ul><li><b>2.0.7</b> 系统资源页网络卡片重新设计：支持多网口切换并显示网卡型号与驱动、上下行速率显示更紧凑准确；休眠硬盘不再误报红色健康警告（真实故障仍标红）；硬盘自检新增历史记录并修复预计剩余时间精度；系统资源页图表精简为极简风格</li><li><b>2.0.6</b> 修复深色模式下下拉框文字空白（风扇控制页「温度源」等下拉框在深色模式下文字与背景同色、部分浏览器内核完全不显示，2.0 以来一直存在）；深色模式下所有下拉框/输入框文字统一显式设为白色，不再受浏览器内核差异影响；下拉选项列表同步适配深色主题（深底白字）</li><li><b>2.0.5</b> 硬盘自检入口合并（A/B/C 并为每块盘一个「硬盘自检」入口，点开按盘给可选方式，在用盘不显示清空式扫描）；新增只读表面扫描（只读不写数据不伤盘，所有盘可用含在用盘/阵列成员）；扫描扇区网格可视化（灰/绿/红/黄 + 面板可最小化收起、后台继续扫）；修复坏块扫描进度卡 0%；温度读数修准（CPU 温度不再偏高约 10°C，检测/温度/风扇三页显示完全一致）；CPU 温度平滑显示（不再瞬间跳变）+ 全部温度取整；温度监控页 5 秒实时刷新；风扇页不再整页闪动（转速/温度照常实时更新）；硬盘健康告警只显示在硬盘 SMART 页、不再顶到全局横幅；温度卡片按 核心/NVMe/SSD/机械 分类展示；数据刷新大幅提速（实时接口毫秒级返回，页面手动刷新可强制重新扫描）</li></ul><!--APP_CHANGELOG_END-->
platform              = x86
source                = thirdparty
maintainer            = han951meng
distributor           = han951meng
maintainer_url         = https://github.com/han951meng
distributor_url        = https://github.com/han951meng
os_min_version        = 0.9.0
desktop_uidir         = ui
desktop_applaunchname = com.dashboard.nasdash.main
ctl_stop              = true
; 统一网关（gatewaySocket/gatewayPrefix）对第三方 app 不可靠：飞牛会周期性清空第三方
; entry.gateway_socket -> 网关转发 404（实测反复清空）。改用 fnpackup 同款【cgi 反代】：
; ui/config 的 url=/cgi/ThirdParty/com.dashboard.nasdash/index.cgi/，ui/index.cgi(bash)
; 把请求 curl 转发到 127.0.0.1:9800（Flask 监听）。飞牛不需要注册 gateway 入口 -> 稳定。
; service_port=9800 + checkport=true 让飞牛探测就绪。
service_port          = 9800
checkport             = true
