appname               = com.dashboard.nasdash
version               = 2.0.5
display_name          = NAS硬件监控
desc                  = <p><b>nasdash</b> 是飞牛OS 上的 NAS 硬件监控面板，把原本要 SSH 敲命令才能查看的 CPU、内存、温度、风扇、硬盘 SMART、阵列卡、存储卷等状态聚合到一个网页里。</p><p><b>主要功能</b>：硬件概览 · 阵列卡 · 硬盘 SMART · 系统资源监控 · 风扇调速 · 存储卷 · Docker 监控 · 温度与硬盘健康告警 · 一键健康报告</p><p>安装时自动安装 smartmontools、lm-sensors、mdadm 等依赖；MegaRAID/HBA 阵列卡所需的 <b>storcli 已随包内置</b>，无需手动下载。</p><!--APP_CHANGELOG_START--><p><b>最近更新</b></p><ul><li><b>2.0.5</b> 硬盘自检入口合并（A/B/C 并为每块盘一个「硬盘自检」入口，点开按盘给可选方式，在用盘不显示清空式扫描）；新增只读表面扫描（只读不写数据不伤盘，所有盘可用含在用盘/阵列成员）；扫描扇区网格可视化（灰/绿/红/黄 + 面板可最小化收起、后台继续扫）；修复坏块扫描进度卡 0%；温度读数修准（CPU 温度不再偏高约 10°C，检测/温度/风扇三页显示完全一致）；CPU 温度平滑显示（不再瞬间跳变）+ 全部温度取整；温度监控页 5 秒实时刷新；风扇页不再整页闪动（转速/温度照常实时更新）；硬盘健康告警只显示在硬盘 SMART 页、不再顶到全局横幅；温度卡片按 核心/NVMe/SSD/机械 分类展示；数据刷新大幅提速（实时接口毫秒级返回，页面手动刷新可强制重新扫描）</li><li><b>2.0.4</b> CPU 使用率修准（修复偶发 0% 与瞬时 100%/50% 尖刺，改为后台 1 秒窗口采样）；系统负载显示两位小数；阵列卡 ROC 温度并入温度监控页与顶部统计；网络卡片独立接口 + 前端 5 秒实时刷新、顶部网络格子同步实时刷新；温度监控页精简、系统资源页任务管理器风格重构；修复网络速率不刷新与虚拟网卡重复合计问题</li><li><b>2.0.3</b> 修复应用中心打开 404(彻底改走 cgi 反代模式：ui/config 改用 /cgi/ThirdParty/com.dashboard.nasdash/index.cgi/ + 新增 ui/index.cgi 转发到 127.0.0.1:9800，对齐 fnpackup 等稳定第三方应用，不再依赖会被飞牛周期性清空的统一网关入口)；删除网关自愈看门狗(cgi 模式不需要)、一键健康报告「复制诊断信息」改弹窗查看运行日志(错误/警告置顶着色)、CPU 温度标注最准封装温度</li></ul><!--APP_CHANGELOG_END-->
platform              = x86
source                = thirdparty
maintainer            = han951meng
distributor           = han951meng
maintainer_url         = https://github.com/han951meng
distributor_url        = https://github.com/han951meng
os_min_version        = 0.9.0
desktop_uidir         = ui
desktop_applaunchname = com.dashboard.nasdash.main
ctl_stop              = true
; 统一网关（gatewaySocket/gatewayPrefix）对第三方 app 不可靠：飞牛会周期性清空第三方
; entry.gateway_socket -> 网关转发 404（实测反复清空）。改用 fnpackup 同款【cgi 反代】：
; ui/config 的 url=/cgi/ThirdParty/com.dashboard.nasdash/index.cgi/，ui/index.cgi(bash)
; 把请求 curl 转发到 127.0.0.1:9800（Flask 监听）。飞牛不需要注册 gateway 入口 -> 稳定。
; service_port=9800 + checkport=true 让飞牛探测就绪。
service_port          = 9800
checkport             = true
