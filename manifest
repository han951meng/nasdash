appname               = com.dashboard.nasdash
version               = 2.0.0
display_name          = NAS硬件监控
desc                  = <p><b>nasdash</b> 是飞牛OS 上的 NAS 硬件监控面板，把原本要 SSH 敲命令才能查看的 CPU、内存、温度、风扇、硬盘 SMART、阵列卡、存储卷等状态聚合到一个网页里。</p><p><b>主要功能</b>：硬件概览 · 阵列卡 · 硬盘 SMART · 系统资源监控 · 风扇调速 · 存储卷 · Docker 监控 · 温度与硬盘健康告警 · 一键健康报告</p><p>安装时自动安装 smartmontools、lm-sensors、mdadm 等依赖；MegaRAID/HBA 阵列卡所需的 <b>storcli 已随包内置</b>，无需手动下载。</p><!--APP_CHANGELOG_START--><p><b>最近更新</b></p><ul><li><b>2.0.0</b> 界面换新装、向飞牛原生应用对齐，新增硬盘 SMART 自检（A 档）、坏块慢扫（B 档）、风扇控制接管总开关。</li></ul><!--APP_CHANGELOG_END-->
platform              = x86
source                = thirdparty
maintainer            = han951meng
distributor           = han951meng
maintainer_url         = https://github.com/han951meng
distributor_url        = https://github.com/han951meng
os_min_version        = 0.9.0
desktop_uidir         = ui
desktop_applaunchname = com.dashboard.nasdash.main
ctl_stop              = true
; 统一网关模式：声明 service_port=9800（仅 127.0.0.1 监听，不对外暴露），
; 飞牛 appcenter 会为本应用创建 gateway/sac 入口，网关/应用中心均可用此端口。
; 同时保留 gatewaySocket=app.sock，应用中心也靠它判断应用已就绪。
service_port          = 9800
checkport             = false
disable_authorization_path = true
